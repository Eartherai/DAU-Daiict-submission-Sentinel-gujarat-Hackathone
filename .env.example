# Copy to .env for local use. Never commit .env.
# Grid passwords and bearer tokens must stay in the process environment only.

# --- demonstration / evaluation store ---------------------------------------
# SAAKSHYA_DB=sqlite:///var/demo.db
# SAAKSHYA_EVIDENCE=var/demo_evidence
# PORT=8080

# --- live government store (separate from demo) -----------------------------
# SAAKSHYA_DB=sqlite:///var/live.db
# SAAKSHYA_EVIDENCE=var/live_evidence

# --- Sentinel Camera Grid (RTSP) --------------------------------------------
# Issued email + access password. Injected at socket open; never logged.
# SENTINEL_GRID_EMAIL=
# SENTINEL_GRID_PASSWORD=
# SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
# SENTINEL_GRID_COOKIE=          # browser session cookie if catalogue needs it

# --- optional copilot (off by default) --------------------------------------
# SAAKSHYA_COPILOT=off
# SAAKSHYA_LLM_KEY=
# SAAKSHYA_GEMINI_VISION=0

# --- map tiles --------------------------------------------------------------
# SAAKSHYA_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- models -----------------------------------------------------------------
# SAAKSHYA_MODELS_OFFLINE=1      # refuse hub fetch; fail fast if cache miss
